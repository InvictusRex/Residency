# Host port 5433 locally (mapped by docker-compose); inside the Docker network it becomes db:5432.
APP_NAME="Society Maintenance Tracker"
ENVIRONMENT=development
DEBUG=true
DATABASE_URL=postgresql+psycopg://smt:smt@127.0.0.1:5433/society_maintenance

# Docker Compose database credentials (db, migrate and backend services).
# The Compose stack builds its internal DATABASE_URL from these automatically.
# NOTE: only applied on first init of the pgdata volume; changing them later
#       requires recreating the database volume.
POSTGRES_USER=smt
POSTGRES_PASSWORD=smt
POSTGRES_DB=society_maintenance

JWT_SECRET_KEY=change-me-generate-a-long-random-string
# Generate a strong production secret, e.g.:
#   python -c "import secrets; print(secrets.token_urlsafe(64))"
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=10
REFRESH_TOKEN_EXPIRE_DAYS=7

CORS_ORIGINS=http://localhost:3000,http://localhost:5173

UPLOAD_DIR=uploads
MAX_UPLOAD_SIZE_MB=5

EMAIL_ENABLED=false
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
EMAIL_FROM=noreply@society.local
# Production email via Resend (https://resend.com):
#   1. Create an API key in your Resend dashboard.
#   2. Add and verify your sending domain so EMAIL_FROM uses your own address.
#   3. Use Resend's SMTP relay (no code change needed; the service already speaks SMTP):
#      EMAIL_ENABLED=true
#      SMTP_HOST=smtp.resend.com
#      SMTP_PORT=465
#      SMTP_USERNAME=resend
#      SMTP_PASSWORD=<RESEND_API_KEY>
#      EMAIL_FROM="Society Portal <notifications@your-domain.com>"
# Port 465 uses implicit TLS; any other port uses STARTTLS.
# Never commit a real API key. Keep it in your deployment's secret store instead.

OVERDUE_THRESHOLD_DAYS=3

# Frontend build-time API base URL (used by the Compose frontend build).
# LOCAL:   http://localhost:8000
# PUBLIC:  https://api.<your-domain>   (then rebuild the frontend image)
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
