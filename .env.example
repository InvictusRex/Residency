# Host port 5433 locally (mapped by docker-compose); inside the Docker network it becomes db:5432.
APP_NAME="Society Maintenance Tracker"
ENVIRONMENT=development
DEBUG=true
DATABASE_URL=postgresql+psycopg://smt:smt@localhost:5433/society_maintenance

JWT_SECRET_KEY=change-me-generate-a-long-random-string
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=120

CORS_ORIGINS=http://localhost:3000,http://localhost:5173

UPLOAD_DIR=uploads
MAX_UPLOAD_SIZE_MB=5

EMAIL_ENABLED=false
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
EMAIL_FROM=noreply@society.local

OVERDUE_THRESHOLD_DAYS=3
