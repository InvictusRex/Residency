# Frontend environment variables (see README for full setup)
# Base URL of the FastAPI backend, without the /api/v1 prefix.
#
# LOCAL development (next dev): http://127.0.0.1:18000
# Docker Compose build (default): http://localhost:8000
# PUBLIC Cloudflare-exposed install: https://api.<your-domain>
#
# NEXT_PUBLIC_* values are baked in at build time, so the Docker image must be
# rebuilt with this variable set when the API URL changes.
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000